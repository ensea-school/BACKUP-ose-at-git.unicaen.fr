<?php

use Workflow\Service\DiagnosticFeuilleDeRouteService as Diag;

/* @var $etat array */

$h = fn(mixed $texte): string => $this->escapeHtml((string)$texte);

$d           = $etat['diagnostic'];
$i           = $d['intervenant'];
$sections    = $etat['sections'];
$parametrage = $etat['parametrage'];

$compter = fn(callable $filtre): int => count(array_filter($d['etapes'], $filtre));
$stats   = [
    'prevues'    => $compter(fn($e) => $e['activation']['prevue']),
    'terminees'  => $compter(fn($e) => $e['etat'] === Diag::ETAT_FRANCHIE),
    'bloquees'   => $compter(fn($e) => $e['etat'] === Diag::ETAT_BLOQUEE),
    'alertes'    => $compter(fn($e) => (bool)$e['alerte']),
    'masquees'   => $compter(fn($e) => $e['activation']['prevue'] && $e['visibilite'] && !$e['visibilite']['visible']),
];

$classesEtat = [
    Diag::ETAT_FRANCHIE   => 'etat-franchie',
    Diag::ETAT_EN_COURS   => 'etat-en-cours',
    Diag::ETAT_A_FAIRE    => 'etat-a-faire',
    Diag::ETAT_BLOQUEE    => 'etat-bloquee',
    Diag::ETAT_NON_PREVUE => 'etat-non-prevue',
    Diag::ETAT_DESACTIVEE => 'etat-non-prevue',
];
$symboles = [
    Diag::CONDITION_REMPLIE     => ['✔', 'ok'],
    Diag::CONDITION_NON_REMPLIE => ['✘', 'ko'],
    Diag::CONDITION_PARTIELLE   => ['◐', 'partiel'],
    Diag::CONDITION_IGNOREE     => ['–', 'ignore'],
];

$tableau = function (array $section) use ($h): string {
    $html = '<h2>' . $h($section['titre']) . '</h2>';
    if (isset($section['erreur'])) {
        return $html . '<p class="erreur">Information indisponible : ' . $h($section['erreur']) . '</p>';
    }
    if (empty($section['lignes'])) {
        return $html . '<p class="note">' . $h($section['vide'] ?? 'Aucune donnée.') . '</p>';
    }
    if (!empty($section['note'])) {
        $html .= '<p class="note">' . $h($section['note']) . '</p>';
    }
    $html .= '<table><tr>';
    foreach ($section['colonnes'] as $colonne) {
        $html .= '<th>' . $h($colonne) . '</th>';
    }
    $html .= '</tr>';
    foreach ($section['lignes'] as $ligne) {
        $html .= '<tr>';
        foreach ($ligne as $n => $cellule) {
            $html .= '<td' . ($n === 0 ? ' class="libelle"' : '') . '>' . $h($cellule) . '</td>';
        }
        $html .= '</tr>';
    }

    return $html . '</table>';
};

?>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <style>
