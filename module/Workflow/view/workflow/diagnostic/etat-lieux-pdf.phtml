                    <td class="<?= $a['niveau'] === 'Erreur' ? 'ko' : 'partiel' ?>"><?= $h($a['niveau']) ?></td>
                    <td><?= (int)$a['numero'] ?>. <?= $h($a['etape']) ?></td>
                    <td><?= $h($a['constat']) ?></td>
                </tr>
            <?php endforeach; ?>
        </table>
    <?php endif; ?>
    <?php if ($parametrage['ecarts']): ?>
        <table>
            <tr><th style="width: 28%">Étape</th><th style="width: 22%">Élément</th><th style="width: 25%">Standard</th><th>Paramétrage actuel</th></tr>
            <?php foreach ($parametrage['ecarts'] as $ecart): ?>
                <tr>
                    <td><?= (int)$ecart['numero'] ?>. <?= $h($ecart['etape']) ?></td>
                    <td><?= $h($ecart['element']) ?></td>
                    <td><?= $h($ecart['standard']) ?></td>
                    <td><?= $h($ecart['actuel']) ?></td>
                </tr>
            <?php endforeach; ?>
        </table>
    <?php elseif (!$parametrage['anomalies']): ?>
        <p>Les étapes concernées par cet intervenant sont paramétrées comme le standard de OSE.</p>
    <?php endif; ?>
<?php endif; ?>

