</p>

<?php foreach ($d['etapes'] as $e): ?>
    <div class="etape <?= $classesEtat[$e['etat']] ?>">
        <span class="etat"><?= $h($e['etatLibelle']) ?><?= $e['courante'] ? ' · étape en cours' : '' ?></span>
        <h3><?= (int)$e['ordre'] ?>. <?= $h($e['libelle']) ?></h3>
        <p class="resume"><?= $h($e['resume']) ?></p>
        <?php if ($e['alerte']): ?>
            <div class="encart encart-alerte"><?= $h($e['alerte']) ?></div>
        <?php endif; ?>
        <?php if ($e['activation']['prevue']): ?>
            <p class="detail"><?= $h($e['activation']['texte']) ?></p>
        <?php endif; ?>
        <?php if ($e['visibilite'] && !$e['visibilite']['visible']): ?>
            <p class="detail">Masquée dans la feuille de route de l'auteur du document : <?= $h(lcfirst($e['visibilite']['texte'])) ?></p>
        <?php endif; ?>
        <?php foreach ($e['conditions'] as $c): [$symbole, $classe] = $symboles[$c['resultat']]; ?>
            <p class="condition">
                <span class="<?= $classe ?>"><?= $symbole ?></span>
                Requiert « <?= $h($c['etapeRequise']) ?> » <span class="note">(<?= $h($c['regle']) ?>)</span> :
                <span class="<?= $classe ?>"><?= $h($c['texte']) ?></span>
            </p>
        <?php endforeach; ?>
        <?php if (count($e['structures']) > 1 || ($e['structures'] && $e['etat'] === Diag::ETAT_EN_COURS)): ?>
            <p class="detail">
                Avancement :
                <?= $h(implode(' · ', array_map(fn($s) => $s['libelle'] . ' ' . $s['pourc'] . ' %' . ($s['atteignable'] ? '' : ' (bloquée)'), $e['structures']))) ?>
            </p>
        <?php endif; ?>
    </div>
<?php endforeach; ?>

<div class="saut"></div>
