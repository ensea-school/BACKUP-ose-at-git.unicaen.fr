        .etat-en-cours { border-left-color: #e4a11b; }
        .etat-bloquee { border-left-color: #9fa6b2; }
        .etat-non-prevue { border-left-color: #e0e0e0; color: #9e9e9e; }
        .etat { float: right; font-size: 7pt; padding: 0 4pt; border-radius: 3pt; background: #eeeeee; }
