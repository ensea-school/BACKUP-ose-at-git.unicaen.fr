    </tr>
    <tr>
        <td class="libelle">Version de OSE</td>
        <td colspan="3"><?= $h($etat['version']) ?></td>
    </tr>
</table>

<table class="stats">
    <tr>
        <td><strong><?= $stats['prevues'] ?></strong>étapes prévues</td>
